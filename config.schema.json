{
  "pluginAlias": "LoopSensor",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "**לופים:** מתג שמפעיל חיישן כל X זמן, או פעם אחת אחרי ספירה לאחור.\n\n**שומר חלונות:** חיישן שנדלק כשהמזגן דלוק וחלון כלשהו פתוח במשך X זמן (למשל כדי לכבות את המזגן).",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Platform Name",
        "type": "string",
        "default": "Loop Sensor",
        "required": true
      },
      "loops": {
        "title": "Loops",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "title": "שם (Name)",
              "type": "string",
              "required": true,
              "placeholder": "לופ מזגן"
            },
            "switchType": {
              "title": "סוג מתג (Switch type)",
              "type": "string",
              "default": "switch",
              "oneOf": [
                {
                  "title": "Switch",
                  "enum": [
                    "switch"
                  ]
                },
                {
                  "title": "Outlet",
                  "enum": [
                    "outlet"
                  ]
                },
                {
                  "title": "Lightbulb",
                  "enum": [
                    "lightbulb"
                  ]
                }
              ]
            },
            "sensorType": {
              "title": "סוג חיישן (Sensor type)",
              "type": "string",
              "default": "contact",
              "oneOf": [
                {
                  "title": "Contact (דלת/חלון)",
                  "enum": [
                    "contact"
                  ]
                },
                {
                  "title": "Motion (תנועה)",
                  "enum": [
                    "motion"
                  ]
                },
                {
                  "title": "Occupancy (נוכחות)",
                  "enum": [
                    "occupancy"
                  ]
                },
                {
                  "title": "Leak (נזילה - התראה קריטית)",
                  "enum": [
                    "leak"
                  ]
                }
              ]
            },
            "mode": {
              "title": "מצב (Mode)",
              "type": "string",
              "default": "loop",
              "oneOf": [
                {
                  "title": "לופ – החיישן נדלק כל X זמן עד שמכבים את המתג",
                  "enum": [
                    "loop"
                  ]
                },
                {
                  "title": "פעם אחת – ספירה לאחור, החיישן נדלק פעם אחת והמתג נכבה",
                  "enum": [
                    "once"
                  ]
                }
              ]
            },
            "interval": {
              "title": "זמן (כל כמה זמן / ספירה לאחור)",
              "type": "number",
              "default": 2,
              "minimum": 1,
              "required": true
            },
            "intervalUnit": {
              "title": "יחידות (Units)",
              "type": "string",
              "default": "minutes",
              "oneOf": [
                {
                  "title": "Seconds",
                  "enum": [
                    "seconds"
                  ]
                },
                {
                  "title": "Minutes",
                  "enum": [
                    "minutes"
                  ]
                },
                {
                  "title": "Hours",
                  "enum": [
                    "hours"
                  ]
                }
              ]
            },
            "pulseSeconds": {
              "title": "כמה שניות החיישן דולק (Pulse seconds)",
              "type": "number",
              "default": 2,
              "minimum": 1,
              "maximum": 60
            },
            "startMode": {
              "title": "מתי הלופ מתחיל (Start)",
              "type": "string",
              "default": "immediate",
              "oneOf": [
                {
                  "title": "מיד כשהמתג נדלק",
                  "enum": [
                    "immediate"
                  ]
                },
                {
                  "title": "אחרי הזמן שנבחר (למשל 2 דקות)",
                  "enum": [
                    "afterInterval"
                  ]
                }
              ]
            },
            "autoOffMinutes": {
              "title": "כיבוי אוטומטי של המתג אחרי X דקות (0 = אף פעם)",
              "type": "number",
              "default": 0,
              "minimum": 0
            },
            "rememberState": {
              "title": "לזכור מצב מתג אחרי הפעלה מחדש של Homebridge",
              "type": "boolean",
              "default": true
            },
            "switchName": {
              "title": "שם המתג (אופציונלי)",
              "type": "string"
            },
            "sensorName": {
              "title": "שם החיישן (אופציונלי)",
              "type": "string"
            },
            "debug": {
              "title": "לוג לכל הפעלת חיישן (Debug)",
              "type": "boolean",
              "default": false
            }
          }
        }
      },
      "guards": {
        "title": "שומר חלונות (Guards)",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "title": "שם",
              "type": "string",
              "required": true,
              "placeholder": "כיבוי מזגן - חלון פתוח"
            },
            "conditionName": {
              "title": "שם מתג התנאי",
              "type": "string",
              "default": "מזגן",
              "description": "מתג שמשקף את המזגן (אוטומציה: מזגן נדלק/כבה ← להדליק/לכבות אותו)"
            },
            "inputs": {
              "title": "חלונות ודלתות",
              "type": "array",
              "items": {
                "title": "שם",
                "type": "string"
              }
            },
            "delay": {
              "title": "אחרי כמה זמן",
              "type": "number",
              "default": 30,
              "minimum": 1,
              "required": true
            },
            "delayUnit": {
              "title": "יחידות",
              "type": "string",
              "default": "minutes",
              "oneOf": [
                {
                  "title": "Seconds",
                  "enum": [
                    "seconds"
                  ]
                },
                {
                  "title": "Minutes",
                  "enum": [
                    "minutes"
                  ]
                },
                {
                  "title": "Hours",
                  "enum": [
                    "hours"
                  ]
                }
              ]
            },
            "sensorType": {
              "title": "סוג חיישן יציאה",
              "type": "string",
              "default": "contact",
              "oneOf": [
                {
                  "title": "Contact",
                  "enum": [
                    "contact"
                  ]
                },
                {
                  "title": "Motion",
                  "enum": [
                    "motion"
                  ]
                },
                {
                  "title": "Occupancy",
                  "enum": [
                    "occupancy"
                  ]
                },
                {
                  "title": "Leak (התראה קריטית)",
                  "enum": [
                    "leak"
                  ]
                }
              ]
            },
            "pulseSeconds": {
              "title": "כמה שניות החיישן דולק",
              "type": "number",
              "default": 2,
              "minimum": 1,
              "maximum": 60
            },
            "sensorName": {
              "title": "שם חיישן היציאה (אופציונלי)",
              "type": "string"
            },
            "rememberState": {
              "title": "לזכור מצבים וספירה אחרי הפעלה מחדש",
              "type": "boolean",
              "default": true
            }
          }
        }
      }
    }
  },
  "layout": [
    {
      "type": "help",
      "helpvalue": "<h5>לופים וטיימרים</h5>"
    },
    {
      "key": "loops",
      "type": "array",
      "notitle": true,
      "orderable": false,
      "buttonText": "הוסף לופ",
      "items": [
        {
          "type": "fieldset",
          "title": "לופ",
          "expandable": true,
          "expanded": true,
          "items": [
            "loops[].name",
            "loops[].mode",
            {
              "type": "div",
              "displayFlex": true,
              "flex-direction": "row",
              "notitle": true,
              "items": [
                {
                  "key": "loops[].switchType",
                  "flex": "1 1 0"
                },
                {
                  "key": "loops[].sensorType",
                  "flex": "1 1 0"
                }
              ]
            },
            {
              "type": "div",
              "displayFlex": true,
              "flex-direction": "row",
              "notitle": true,
              "items": [
                {
                  "key": "loops[].interval",
                  "flex": "1 1 0"
                },
                {
                  "key": "loops[].intervalUnit",
                  "flex": "1 1 0"
                },
                {
                  "key": "loops[].pulseSeconds",
                  "flex": "1 1 0"
                }
              ]
            },
            {
              "key": "loops[].startMode",
              "condition": {
                "functionBody": "return model.loops?.[arguments[1]]?.mode !== 'once';"
              }
            },
            {
              "type": "fieldset",
              "title": "אפשרויות נוספות",
              "expandable": true,
              "expanded": false,
              "items": [
                {
                  "key": "loops[].autoOffMinutes",
                  "condition": {
                    "functionBody": "return model.loops?.[arguments[1]]?.mode !== 'once';"
                  }
                },
                "loops[].rememberState",
                "loops[].switchName",
                "loops[].sensorName",
                "loops[].debug"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "help",
      "helpvalue": "<h5>שומר חלונות</h5><p>המזגן דלוק + לפחות חלון אחד פתוח במשך הזמן שנבחר ← החיישן נדלק פעם אחת. כל החלונות נסגרו או המזגן כבה ← הספירה מתבטלת.</p>"
    },
    {
      "key": "guards",
      "type": "array",
      "notitle": true,
      "orderable": false,
      "buttonText": "הוסף שומר",
      "items": [
        {
          "type": "fieldset",
          "title": "שומר",
          "expandable": true,
          "expanded": true,
          "items": [
            "guards[].name",
            "guards[].conditionName",
            {
              "type": "div",
              "displayFlex": true,
              "flex-direction": "row",
              "notitle": true,
              "items": [
                {
                  "key": "guards[].delay",
                  "flex": "1 1 0"
                },
                {
                  "key": "guards[].delayUnit",
                  "flex": "1 1 0"
                }
              ]
            },
            {
              "key": "guards[].inputs",
              "type": "array",
              "buttonText": "הוסף חלון / דלת",
              "items": [
                {
                  "key": "guards[].inputs[]",
                  "notitle": true,
                  "placeholder": "חלון סלון"
                }
              ]
            },
            {
              "type": "fieldset",
              "title": "אפשרויות נוספות",
              "expandable": true,
              "expanded": false,
              "items": [
                {
                  "type": "div",
                  "displayFlex": true,
                  "flex-direction": "row",
                  "notitle": true,
                  "items": [
                    {
                      "key": "guards[].sensorType",
                      "flex": "1 1 0"
                    },
                    {
                      "key": "guards[].pulseSeconds",
                      "flex": "1 1 0"
                    }
                  ]
                },
                "guards[].sensorName",
                "guards[].rememberState"
              ]
            }
          ]
        }
      ]
    }
  ]
}
