{
  "pluginAlias": "LoopSensor",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "מתג שמפעיל חיישן בלופים: כשהמתג דלוק, החיישן נדלק לרגע כל X זמן. כשהמתג כבוי, הכל עוצר.",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Platform Name",
        "type": "string",
        "default": "Loop Sensor",
        "required": true
      },
      "loops": {
        "title": "Loops",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "title": "שם (Name)",
              "type": "string",
              "required": true,
              "placeholder": "לופ מזגן"
            },
            "switchType": {
              "title": "סוג מתג (Switch type)",
              "type": "string",
              "default": "switch",
              "oneOf": [
                {
                  "title": "Switch",
                  "enum": [
                    "switch"
                  ]
                },
                {
                  "title": "Outlet",
                  "enum": [
                    "outlet"
                  ]
                },
                {
                  "title": "Lightbulb",
                  "enum": [
                    "lightbulb"
                  ]
                }
              ]
            },
            "sensorType": {
              "title": "סוג חיישן (Sensor type)",
              "type": "string",
              "default": "contact",
              "oneOf": [
                {
                  "title": "Contact (דלת/חלון)",
                  "enum": [
                    "contact"
                  ]
                },
                {
                  "title": "Motion (תנועה)",
                  "enum": [
                    "motion"
                  ]
                },
                {
                  "title": "Occupancy (נוכחות)",
                  "enum": [
                    "occupancy"
                  ]
                },
                {
                  "title": "Leak (נזילה - התראה קריטית)",
                  "enum": [
                    "leak"
                  ]
                }
              ]
            },
            "interval": {
              "title": "כל כמה זמן (Interval)",
              "type": "number",
              "default": 2,
              "minimum": 1,
              "required": true
            },
            "intervalUnit": {
              "title": "יחידות (Units)",
              "type": "string",
              "default": "minutes",
              "oneOf": [
                {
                  "title": "Seconds",
                  "enum": [
                    "seconds"
                  ]
                },
                {
                  "title": "Minutes",
                  "enum": [
                    "minutes"
                  ]
                },
                {
                  "title": "Hours",
                  "enum": [
                    "hours"
                  ]
                }
              ]
            },
            "pulseSeconds": {
              "title": "כמה שניות החיישן דולק (Pulse seconds)",
              "type": "number",
              "default": 2,
              "minimum": 1,
              "maximum": 60
            },
            "startMode": {
              "title": "מתי הלופ מתחיל (Start)",
              "type": "string",
              "default": "immediate",
              "oneOf": [
                {
                  "title": "מיד כשהמתג נדלק",
                  "enum": [
                    "immediate"
                  ]
                },
                {
                  "title": "אחרי הזמן שנבחר (למשל 2 דקות)",
                  "enum": [
                    "afterInterval"
                  ]
                }
              ]
            },
            "autoOffMinutes": {
              "title": "כיבוי אוטומטי של המתג אחרי X דקות (0 = אף פעם)",
              "type": "number",
              "default": 0,
              "minimum": 0
            },
            "rememberState": {
              "title": "לזכור מצב מתג אחרי הפעלה מחדש של Homebridge",
              "type": "boolean",
              "default": true
            },
            "switchName": {
              "title": "שם המתג (אופציונלי)",
              "type": "string"
            },
            "sensorName": {
              "title": "שם החיישן (אופציונלי)",
              "type": "string"
            },
            "debug": {
              "title": "לוג לכל הפעלת חיישן (Debug)",
              "type": "boolean",
              "default": false
            }
          }
        }
      }
    }
  },
  "layout": [
    {
      "key": "loops",
      "type": "array",
      "notitle": true,
      "orderable": false,
      "buttonText": "הוסף לופ",
      "items": [
        {
          "type": "fieldset",
          "title": "לופ",
          "expandable": true,
          "expanded": true,
          "items": [
            "loops[].name",
            {
              "type": "div",
              "displayFlex": true,
              "flex-direction": "row",
              "notitle": true,
              "items": [
                {
                  "key": "loops[].switchType",
                  "flex": "1 1 0"
                },
                {
                  "key": "loops[].sensorType",
                  "flex": "1 1 0"
                }
              ]
            },
            {
              "type": "div",
              "displayFlex": true,
              "flex-direction": "row",
              "notitle": true,
              "items": [
                {
                  "key": "loops[].interval",
                  "flex": "1 1 0"
                },
                {
                  "key": "loops[].intervalUnit",
                  "flex": "1 1 0"
                },
                {
                  "key": "loops[].pulseSeconds",
                  "flex": "1 1 0"
                }
              ]
            },
            "loops[].startMode",
            {
              "type": "fieldset",
              "title": "אפשרויות נוספות",
              "expandable": true,
              "expanded": false,
              "items": [
                "loops[].autoOffMinutes",
                "loops[].rememberState",
                "loops[].switchName",
                "loops[].sensorName",
                "loops[].debug"
              ]
            }
          ]
        }
      ]
    }
  ]
}
