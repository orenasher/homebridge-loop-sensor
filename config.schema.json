{"pluginAlias":"WindyCamera","pluginType":"platform","singular":true,"headerDisplay":"Windy rain radar camera + current weather overlay + rain sensor. Standalone - no other plugin needed. מצלמת מכ״ם גשם עצמאית עם תחזית עכשווית וחיישן גשם.","schema":{"type":"object","properties":{"name":{"title":"Camera name / שם המצלמה","type":"string","default":"מכ״ם גשם"},"city":{"title":"City / עיר","type":"string","default":"כפר יונה","oneOf":[{"title":"כפר יונה","enum":["כפר יונה"]},{"title":"נתניה","enum":["נתניה"]},{"title":"תל אביב - יפו","enum":["תל אביב - יפו"]},{"title":"חיפה","enum":["חיפה"]},{"title":"ירושלים","enum":["ירושלים"]},{"title":"באר שבע","enum":["באר שבע"]},{"title":"אשדוד","enum":["אשדוד"]},{"title":"אילת","enum":["אילת"]},{"title":"רעננה","enum":["רעננה"]},{"title":"חדרה","enum":["חדרה"]},{"title":"מותאם אישית (הזן קווים ידנית)","enum":["מותאם אישית (הזן קווים ידנית)"]}]},"lat":{"title":"Latitude (custom only)","type":"number","condition":{"functionBody":"return model.city === 'מותאם אישית (הזן קווים ידנית)';"}},"lon":{"title":"Longitude (custom only)","type":"number","condition":{"functionBody":"return model.city === 'מותאם אישית (הזן קווים ידנית)';"}},"locationName":{"title":"Label shown on the image (optional)","type":"string","description":"Defaults to the city name. Useful with a custom location."},"quality":{"title":"Radar image quality","type":"string","default":"high","oneOf":[{"title":"Low (800x550, light)","enum":["low"]},{"title":"Medium (1000x700)","enum":["medium"]},{"title":"High (1300x900) - default","enum":["high"]},{"title":"Ultra (1300x900 at 2x sharpness)","enum":["ultra"]}],"description":"Higher quality = sharper image but more CPU/RAM on the Raspberry Pi."},"width":{"title":"Width override (px)","type":"integer","minimum":320,"maximum":3840,"description":"Optional. Overrides the width of the quality preset."},"height":{"title":"Height override (px)","type":"integer","minimum":240,"maximum":2160,"description":"Optional. Overrides the hei