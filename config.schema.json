d)","enum":["both"]},{"title":"Measured precipitation only","enum":["precipitation"]},{"title":"Weather code only","enum":["weatherCode"]}]},"rainThresholdMm":{"title":"Rain threshold (mm)","type":"number","default":0.1,"minimum":0},"timezone":{"title":"Timezone (optional, e.g. Asia/Jerusalem)","type":"string"}}},"overlay":{"type":"object","title":"Weather on the image","properties":{"enabled":{"title":"Show weather on the camera image","type":"boolean","default":true},"position":{"title":"Position","type":"string","default":"top-left","oneOf":[{"title":"top-left","enum":["top-left"]},{"title":"top-center","enum":["top-center"]},{"title":"top-right","enum":["top-right"]},{"title":"middle-left","enum":["middle-left"]},{"title":"middle-right","enum":["middle-right"]},{"title":"bottom-left","enum":["bottom-left"]},{"title":"bottom-center","enum":["bottom-center"]},{"title":"bottom-right","enum":["bottom-right"]}]},"layout":{"title":"Layout","type":"string","default":"card","oneOf":[{"title":"Compact (icon + temperature)","enum":["compact"]},{"title":"Card","enum":["card"]},{"title":"Detailed (card + forecast)","enum":["detailed"]},{"title":"Full-width banner","enum":["banner"]},{"title":"Custom HTML template","enum":["custom"]}]},"theme":{"title":"Theme","type":"string","default":"dark","oneOf":[{"title":"dark","enum":["dark"]},{"title":"light","enum":["light"]},{"title":"glass","enum":["glass"]},{"title":"transparent","enum":["transparent"]},{"title":"Custom (use the colors below)","enum":["custom"]}]},"scale":{"title":"Size (0.5-3)","type":"number","default":1,"minimum":0.5,"maximum":3},"opacity":{"title":"Background opacity (0.1-1)","type":"number","default":0.85,"minimum":0.1,"maximum":1},"margin":{"title":"Margin from edge (px)","type":"integer","default":24,"minimum":0},"borderRadius":{"title":"Corner radius (px)","type":"integer","default":16,"minimum":0},"textColor":{"title":"Text color (any CSS color)","type":"string"},"backgroundColor":{"title":"Background co